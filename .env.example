# 实时文本聊天系统 - 环境变量配置示例

# 服务器配置
PORT=9000
NODE_ENV=production

# 聊天配置
MAX_MESSAGES=100
MAX_MESSAGE_LENGTH=500
MAX_USERNAME_LENGTH=20
TYPING_TIMEOUT=3000
CLEANUP_INTERVAL=300000

# 日志配置
LOG_LEVEL=info
LOG_TO_FILE=false
LOG_FILE_PATH=./logs/app.log

# CORS配置
CORS_ORIGIN=*
CORS_METHODS=GET,POST

# 其他配置
TRUST_PROXY=false