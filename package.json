{
  "name": "text-chat",
  "version": "4.0.0",
  "private": true,
  "description": "实时文本聊天应用 - pnpm monorepo",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n backend,frontend -c green,blue \"pnpm --filter @text-chat/backend dev\" \"pnpm --filter @text-chat/frontend dev\"",
    "dev:backend": "pnpm --filter @text-chat/backend dev",
    "dev:frontend": "pnpm --filter @text-chat/frontend dev",
    "build": "pnpm -r --filter @text-chat/shared --filter @text-chat/backend --filter @text-chat/frontend build",
    "build:shared": "pnpm --filter @text-chat/shared build",
    "build:backend": "pnpm --filter @text-chat/backend build",
    "build:frontend": "pnpm --filter @text-chat/frontend build",
    "deploy": "node script/deploy.js",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"packages/**/*.{js,vue,json}\""
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "prettier": "^3.9.9"
  },
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=10.15.0"
  }
}