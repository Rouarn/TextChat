{
  "name": "text-chat",
  "version": "3.0.0",
  "description": "实时文本聊天应用 - 基于 @vakao-ui/socket-system 重构",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
